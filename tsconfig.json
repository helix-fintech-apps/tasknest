{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@domain": [
        "supabase/functions/_shared/domain/index.ts"
      ],
      "@domain/*": [
        "supabase/functions/_shared/domain/*"
      ]
    },
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "supabase/functions/_shared/domain",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
