{
  "name": "tasknest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit --coverage.enabled",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "db:check": "psql \"${SUPABASE_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f scripts/ci/db_checks.sql",
    "bundle:functions": "bash scripts/bundle-edge-functions.sh",
    "check:functions": "deno check supabase/functions/api/index.ts supabase/functions/stripe-webhook/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "^0.21.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@stripe/connect-js": "3.5.0",
    "@stripe/react-connect-js": "3.5.0",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "@supabase/supabase-js": "^2.117.1",
    "lucide-react": "1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  }
}
